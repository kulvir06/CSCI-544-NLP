# Optional overrides. Defaults are relative to the repository root.
NLP_DATA_DIR=
NLP_MAX_UPLOAD_BYTES=26214400

# Local model-backed temporal claim extraction and semantic retrieval.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEMPORAL_MODEL=qwen2.5:3b
OLLAMA_FALLBACK_TEMPORAL_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_PRIMARY_NUM_PREDICT=600
OLLAMA_FALLBACK_NUM_PREDICT=900
OLLAMA_FALLBACK_CONFIDENCE_THRESHOLD=0.70
TEMPORAL_CONFIDENCE_THRESHOLD=0.65
TEMPORAL_RELEVANCE_RATIO=0.80

# The corpus pipeline is intentionally upload-only. There is no setting that
# enables URL fetching, crawling, or website scraping.
